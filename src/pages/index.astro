              <span class="comp__head">
                <span class="comp__icon" set:html={compIcons[c.label] ?? defaultCardIcon} />
                <span class="comp__label">{c.label}</span>
              </span>
              <span class="comp__detail">{c.detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ═══ skills ═══ -->
    <section class="wrap block block--last">
      <header class="block__head">
        <p class="eyebrow"><span class="eyebrow__icon" set:html={sectionEyebrowIcons['Technical skills']} />Technical skills</p>
