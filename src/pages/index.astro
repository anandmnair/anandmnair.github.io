            </dt>
            <dd>
              {s.items.map((i) => (
                <span class="tag">
                  <span class="tag__icon" set:html={skillItemIcons[i] ?? defaultCardIcon} />
                  {i}
                </span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
</BaseLayout>

