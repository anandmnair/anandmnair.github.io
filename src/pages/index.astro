---

<BaseLayout description={home.data.description}>
  <main id="main" data-pagefind-body>
    <!-- ═══ who ═══ -->
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <div class="hero__text">
          <p class="eyebrow">{[site.role, site.location].filter(Boolean).join(' · ')}</p>
          <h1 class="hero__name">{site.name}</h1>
          <p class="hero__line">
            {site.taglineLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
          <div class="hero__cta">
            {site.socials.map((s, i) => (
              <a class:list={['btn', { 'btn--primary': i === 0 }]} href={s.href} rel="me noopener">{s.label}</a>
            ))}
            <a class="btn" href="#open-source">Open source</a>
          </div>
        </div>

        <div class="hero__mark"><Monogram /></div>
      </div>

      {stats.length > 0 && (
        <div class="wrap">
          <dl class="stats">
            {stats.map((s) => (
              <div class="stats__item">
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </section>

    <!-- ═══ about ═══ -->
    <section class="wrap block about-block">
      <div class="about-block__main">
        <header class="block__head">
          <p class="eyebrow"><span class="eyebrow__icon" set:html={sectionEyebrowIcons['About me']} />About me</p>
          <h2 class="block__title">The short version</h2>
        </header>

        <div class="about__prose prose"><Content /></div>
      </div>

      <aside class="about__side">
        <dl class="vitals">
          {vitals.map((v) => (
            <div class="vitals__row">
              <dt><span class="vitals__icon" set:html={vitalIcons[v.label] ?? ''} />{v.label}</dt>
              <dd>{v.value}</dd>
            </div>
          ))}
        </dl>
        <a class="about__more" href="/about/">The long version →</a>
        {site.wip.enabled && (
          <p class="wipnote"><span>{site.wip.label}</span> {site.wip.note}</p>
        )}
      </aside>
    </section>

    <!-- ═══ open source ═══ -->
    <section class="os" id="open-source">
      <div class="wrap">
        <header class="block__head os__head">
          <div>
            <p class="eyebrow eyebrow--accent"><span class="eyebrow__icon" set:html={sectionEyebrowIcons['Open source']} />Open source</p>
            <h2 class="block__title">Open Source Contributions :: Libraries in production, not demos</h2>
            <p class="os__sub">
              Each of these started as an internal fix for a problem that kept recurring across
              teams, and earned its way out.
            </p>
          </div>
          <a class="btn" href="/projects/">All projects</a>
        </header>

        <ProjectCards projects={projects} />
      </div>
    </section>

    <!-- ═══ start here ═══ -->
    <section class="wrap block">
      <header class="block__head">
        <p class="eyebrow"><span class="eyebrow__icon" set:html={sectionEyebrowIcons['Start here']} />Start here</p>
        <h2 class="block__title">If you only read three things</h2>
      </header>
      <div class="starters">
        {starterCards.map((s) => (
          <a class="starter" href={s.href}>
            <span class="starter__head">
              <span class="starter__icon" set:html={starterIcons[s.label] ?? defaultCardIcon} />
              <span class="starter__label">{s.label}</span>
            </span>
            <span class="starter__desc">{s.description}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══ competencies ═══ -->
    <section class="wrap block">
      <header class="block__head">
        <p class="eyebrow"><span class="eyebrow__icon" set:html={sectionEyebrowIcons['Core competencies']} />Core competencies</p>
