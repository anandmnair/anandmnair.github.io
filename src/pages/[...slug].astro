---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import SectionCards from '../components/SectionCards.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { routeOf, sectionOf } from '../nav';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs
    .filter((d) => d.id !== 'home' && d.id !== 'projects')
    .map((doc) => ({ params: { slug: routeOf(doc.id).replace(/^\/|\/$/g, '') }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

let cardItems: { title: string; description: string; href: string; badges?: string[] }[] = [];
if (doc.data.cards) {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  cardItems = docs
    .filter((d) => sectionOf(d.id) === doc.id && d.id !== doc.id)
    .sort((a, b) => a.data.order - b.data.order)
    .map((d) => ({
      title: d.data.title,
      description: d.data.description,
      href: routeOf(d.id),
      badges: d.data.cardBadges,
    }));
}
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  section={sectionOf(doc.id)}
  updated={doc.data.updated}
  tags={doc.data.tags}
  headings={headings}
>
  <Content />
  {cardItems.length > 0 && <SectionCards items={cardItems} />}
  {doc.data.projects && doc.data.projects.length > 0 && (
    <>
      <h2>{doc.data.title} Projects</h2>
      <ProjectCards projects={doc.data.projects} />
    </>
  )}
</DocsLayout>
