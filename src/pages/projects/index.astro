---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import { sectionOf } from '../../nav';

const docs = await getCollection('docs', ({ data }) => !data.draft);
const doc = docs.find((d) => d.id === 'projects')!;
const { Content, headings } = await render(doc);

const allProjects = doc.data.projects ?? [];
const openSourceProjects = allProjects.filter((p) => p.badges?.includes('opensource'));
const otherProjects = allProjects.filter((p) => !p.badges?.includes('opensource'));
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  section={sectionOf(doc.id)}
  updated={doc.data.updated}
  tags={doc.data.tags}
  headings={headings}
>
  <Content />
  <h2>Open Source</h2>
  <ProjectCards projects={openSourceProjects} />
  <h2>Products, POCs &amp; Experiments</h2>
  <ProjectCards projects={otherProjects} />
</DocsLayout>
