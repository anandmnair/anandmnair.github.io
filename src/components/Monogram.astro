---
import { site } from '../site';
/* A hexagon for hexagonal architecture, with the ports drawn on its edges. */
---

<div class="mono" aria-hidden="true">
  <svg viewBox="0 0 260 260">
    <defs>
      <linearGradient id="mg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.16" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </linearGradient>
    </defs>

    <g class="mono__rings">
      <circle cx="130" cy="130" r="118" />
      <circle cx="130" cy="130" r="96" />
    </g>

    <path class="mono__fill" d="M130 34 208 79v90l-78 45-78-45V79z" fill="url(#mg)" />
    <path class="mono__hex" d="M130 34 208 79v90l-78 45-78-45V79z" />
    <path class="mono__hex mono__hex--inner" d="M130 62 184 93v62l-54 31-54-31V93z" />

    <g class="mono__ports">
      <circle cx="130" cy="34" r="6" /><circle cx="208" cy="79" r="6" />
      <circle cx="208" cy="169" r="6" /><circle cx="130" cy="214" r="6" />
      <circle cx="52" cy="169" r="6" /><circle cx="52" cy="79" r="6" />
    </g>

    <text class="mono__text" x="130" y="141" text-anchor="middle">{site.initials}</text>
  </svg>
</div>

<style>
  .mono { width: min(100%, 300px); margin-inline: auto; }
  .mono svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* Darker ring in light theme, lighter ring in dark theme — both need more contrast against --bg. */
  .mono__rings circle { fill: none; stroke: color-mix(in oklab, var(--ink) 42%, transparent); stroke-width: 1; stroke-dasharray: 2 7; }
  :global(:root[data-theme='dark']) .mono__rings circle { stroke: color-mix(in oklab, var(--ink) 40%, transparent); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .mono__rings circle { stroke: color-mix(in oklab, var(--ink) 40%, transparent); }
  }
  .mono__rings circle:first-child { animation: spin 70s linear infinite; transform-origin: 130px 130px; }
  .mono__rings circle:last-child { animation: spin 50s linear infinite reverse; transform-origin: 130px 130px; }

  .mono__hex { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
  .mono__hex--inner { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 5; }

  .mono__ports circle { fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
  .mono__ports circle:nth-child(2n) { fill: var(--accent); }

  .mono__text {
    font-family: var(--font-display);
    font-size: 58px;
    font-weight: 800;
    fill: var(--ink);
    letter-spacing: -0.02em;
  }

  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .mono__rings circle { animation: none; }
  }
</style>
