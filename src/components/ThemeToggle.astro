---
/* Three-state theme control: system -> light -> dark. Persisted in localStorage. */
---

<div class="theme-toggle" role="group" aria-label="Colour theme">
  <button type="button" data-theme-set="light" aria-label="Light theme" title="Light">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><g stroke-linecap="round"><path d="M12 2.6v2.4M12 19v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.6 12h2.4M19 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/></g></svg>
  </button>
  <button type="button" data-theme-set="system" aria-label="Match system theme" title="System">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="12" rx="1.6"/><path d="M8.5 20h7" stroke-linecap="round"/></svg>
  </button>
  <button type="button" data-theme-set="dark" aria-label="Dark theme" title="Dark">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z"/></svg>
  </button>
  <span class="thumb" aria-hidden="true"></span>
</div>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-sunken);
  }
  .theme-toggle button {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--muted);
    border-radius: 999px;
    transition: color 0.2s var(--ease);
  }
  .theme-toggle button:hover { color: var(--ink); }
  .theme-toggle button[aria-pressed='true'] { color: var(--accent-ink); }
  .theme-toggle svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    transition: transform 0.28s var(--ease);
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const wrap = document.querySelector('.theme-toggle');
    if (!wrap) return;
    const buttons = [...wrap.querySelectorAll('button')];
    const thumb = wrap.querySelector('.thumb');
    const order = ['light', 'system', 'dark'];

    const paint = (mode) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === mode)));
      thumb.style.transform = `translateX(${order.indexOf(mode) * 28}px)`;
    };

    const apply = (mode) => {
      if (mode === 'system') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', mode);
      try { localStorage.setItem('theme', mode); } catch {}
      paint(mode);
    };

    let saved = 'system';
    try { saved = localStorage.getItem('theme') || 'system'; } catch {}
    paint(order.includes(saved) ? saved : 'system');

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.themeSet)));
  })();
</script>
