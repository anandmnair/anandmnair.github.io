---
import { site } from '../site';

const year = new Date().getFullYear();
/* The 12 sections already live in the top tab bar — the footer stays a single line. */
---

<footer class="ftr">
  <div class="ftr__inner">
    <p class="ftr__who">
      <span class="ftr__badge" aria-hidden="true">{site.initials}</span>
      <span class="ftr__name">{site.name}</span>
      <span class="ftr__meta">{[site.role, site.location].filter(Boolean).join(' · ')}</span>
    </p>

    <nav class="ftr__links" aria-label="Elsewhere">
      {site.socials.map((s) => <a href={s.href} rel="me noopener">{s.label}</a>)}
      <a href="https://github.com/anandmnair/anandmnair.github.io">Source</a>
    </nav>

    <p class="ftr__legal">© {year}</p>
  </div>
</footer>

<style>
  .ftr {
    margin-top: 0;
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
    position: relative;
    z-index: 1;
  }
  .ftr__inner {
    width: min(100% - 2.5rem, var(--shell));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem var(--space-3);
    min-height: 3.25rem;
    padding-block: 0.6rem;
  }

  .ftr__who { display: flex; align-items: center; gap: 0.55rem; margin: 0; min-width: 0; }
  .ftr__badge {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }
  .ftr__name { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; letter-spacing: -0.02em; }
  .ftr__meta { color: var(--muted); font-size: 0.78rem; }
  .ftr__meta::before { content: '·'; margin-right: 0.5rem; }

  .ftr__links { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-left: auto; font-size: 0.82rem; }
  .ftr__links a { color: var(--ink-soft); text-decoration: none; }
  .ftr__links a:hover { color: var(--accent-ink); }

  .ftr__legal { margin: 0; font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }

  @media (max-width: 700px) {
    .ftr__meta { display: none; }
    .ftr__links { margin-left: 0; width: 100%; }
  }
</style>
