---
interface CardItem {
  title: string;
  description: string;
  href: string;
  badges?: string[];
}

interface Props {
  items: CardItem[];
}

const { items } = Astro.props;

const cardIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>';
---

<div class="cards">
  {items.map((item) => (
    <article class="card">
      <div class="card__top">
        <span class="card__icon" set:html={cardIcon} />
        <h3 class="card__title"><a href={item.href}>{item.title}</a></h3>
        <svg class="card__arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 18 18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      {item.badges && item.badges.length > 0 && (
        <p class="card__badges">
          {item.badges.map((b) => <span class="card__badge">{b}</span>)}
        </p>
      )}
      <p class="card__desc">{item.description}</p>
      <p class="card__foot"><a class="card__more" href={item.href}>Read →</a></p>
    </article>
  ))}
</div>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-3); }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    position: relative;
    overflow: hidden;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), transparent 70%);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  .card:hover::before { transform: scaleX(1); }

  .card__top { display: flex; align-items: center; gap: 0.55rem; }
  .card__icon { flex: none; width: 22px; height: 22px; color: var(--accent-ink); border-radius: 5px; overflow: hidden; }
  .card__icon svg { width: 100%; height: 100%; display: block; }
  .card__title { margin: 0; margin-right: auto; font-size: var(--step-1); line-height: 1.2; }
  .card__title a { color: inherit; text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card:hover .card__title a { color: var(--accent-ink); }
  .card__arrow { width: 16px; height: 16px; flex: none; color: var(--muted); transition: color 0.2s var(--ease), transform 0.25s var(--ease); }
  .card:hover .card__arrow { color: var(--accent); transform: translate(2px, -2px); }

  .card__badges { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; }
  .card__badge {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    color: var(--accent-ink);
    background: var(--accent-wash);
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
  }
  .card__desc { margin: 0; flex: 1; color: var(--ink-soft); font-size: var(--step--1); line-height: 1.55; }
  .card__foot {
    margin: var(--space-2) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    position: relative;
    z-index: 1;
  }
  .card__more { font-family: var(--font-mono); font-size: 0.72rem; }
</style>
