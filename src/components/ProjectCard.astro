---
interface Props {
  href: string;
  title: string;
  description: string;
  year?: string;
  language?: string;
  tags?: string[];
  featured?: boolean;
}
const { href, title, description, year, language, tags = [], featured = false } = Astro.props;
---

<a class:list={['card', { 'card--featured': featured }]} href={href}>
  <div class="card__top">
    <h3 class="card__title">{title}</h3>
    <svg class="card__arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 18 18 6M9 6h9v9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <p class="card__desc">{description}</p>
  <div class="card__foot">
    {language && <span class="card__lang">{language}</span>}
    {year && <span class="card__year">{year}</span>}
    {tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    color: inherit;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s var(--ease);
  }
  .card:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--shadow); }
  .card:hover::after { transform: scaleY(1); }
  .card--featured { background: linear-gradient(160deg, var(--accent-wash), var(--bg-elev) 55%); }

  .card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
  .card__title { margin: 0; font-size: var(--step-1); }
  .card__arrow { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.6; transition: stroke 0.2s var(--ease), transform 0.25s var(--ease); }
  .card:hover .card__arrow { stroke: var(--accent); transform: translate(2px, -2px); }
  .card__desc { margin: 0; color: var(--ink-soft); font-size: var(--step--1); line-height: 1.55; flex: 1; }
  .card__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.75rem; }
  .card__lang, .card__year { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); letter-spacing: 0.04em; }
  .card__lang::before { content: '● '; color: var(--accent); }
</style>
