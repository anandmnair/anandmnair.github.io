---
interface Project {
  name: string;
  stack: string;
  blurb: string;
  page: string;
  repo: string;
  docs?: string;
  year?: number;
  badges?: ('poc' | 'product' | 'library' | 'opensource' | 'experimental')[];
}

const badgeLabels: Record<string, string> = {
  poc: 'POC',
  product: 'Product',
  library: 'Library',
  opensource: 'Open Source',
  experimental: 'Experimental',
};

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const defaultCardIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>';

// Failover's own mark, pulled from its docs site (societe-generale.github.io/failover/web/assets/logo.svg).
const projectIcons: Record<string, string> = {
  Failover:
    '<svg viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#6366f1"/><path d="M26 20 h48 v16 H44 v12 h26 v14 H44 v18 H26 Z" fill="#fff"/><circle cx="76" cy="72" r="7" fill="#a5b4fc"/></svg>',
  'RabbitMQ Advanced Spring Boot Starter':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h13l3 3-3 3H4z"/><path d="M4 17h13l3-3"/></svg>',
  'Failover Demo':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M10 8.5v7l6-3.5z" fill="currentColor" stroke="none"/></svg>',
  // AIDLC's own mark, from its docs site (anandmnair.github.io/aidlc/web/assets/logo.svg).
  AIDLC:
    '<svg viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="aidlc-card-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c8cf8"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs><circle cx="32" cy="32" r="23" fill="none" stroke="url(#aidlc-card-g)" stroke-width="5" stroke-linecap="round" stroke-dasharray="112 38"/><path d="M49 13 L58 17 L52 24 Z" fill="#22d3ee"/><g fill="url(#aidlc-card-g)"><circle cx="32" cy="18.3" r="2.4"/><rect x="31" y="19.8" width="2" height="5"/><rect x="21.5" y="24.5" width="21" height="18" rx="4.5"/><rect x="18.4" y="30" width="3" height="7" rx="1.5"/><rect x="42.6" y="30" width="3" height="7" rx="1.5"/></g><g fill="#ffffff"><circle cx="27.5" cy="32.3" r="2.7"/><circle cx="36.5" cy="32.3" r="2.7"/><rect x="27.5" y="37.4" width="9" height="2.4" rx="1.2"/></g></svg>',
  // KBP's own mark, from its docs site (anandmnair.github.io/KnowledgeBase-Platform/web/assets/logo.svg).
  'KnowledgeBase Platform':
    '<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="#1565c0"/><circle cx="16" cy="18" r="4" fill="#90caf9"/><circle cx="32" cy="18" r="4" fill="#90caf9"/><circle cx="24" cy="32" r="4" fill="#90caf9"/><line x1="16" y1="18" x2="24" y2="32" stroke="#e3f2fd" stroke-width="1.6"/><line x1="32" y1="18" x2="24" y2="32" stroke="#e3f2fd" stroke-width="1.6"/><line x1="16" y1="18" x2="32" y2="18" stroke="#e3f2fd" stroke-width="1.6"/></svg>',
};
---

<div class="projects">
  {projects.map((p) => (
    <article class="proj">
      <div class="proj__top">
        <span class="proj__icon" set:html={projectIcons[p.name] ?? defaultCardIcon} />
        <h3 class="proj__name"><a href={p.page}>{p.name}</a></h3>
        <svg class="proj__arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 18 18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <p class="proj__stack">{p.stack.split(' · ').map((s) => <span>{s}</span>)}</p>
      {(p.year || p.badges?.length) && (
        <p class="proj__tags">
          {p.year && <span class="proj__badge proj__badge--year">Since {p.year}</span>}
          {p.badges?.map((b) => <span class={`proj__badge proj__badge--${b}`}>{badgeLabels[b]}</span>)}
        </p>
      )}
      <p class="proj__blurb">{p.blurb}</p>
      <p class="proj__links">
        <a href={p.repo} rel="noopener">Repository</a>
        {p.docs && <a href={p.docs} rel="noopener">Docs</a>}
        <a class="proj__more" href={p.page}>Read more</a>
      </p>
    </article>
  ))}
</div>

<style>
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: var(--space-3); }
  .proj {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    position: relative;
    overflow: hidden;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .proj::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), transparent 70%);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .proj:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  .proj:hover::before { transform: scaleX(1); }

  .proj__top { display: flex; align-items: center; gap: 0.55rem; }
  .proj__icon { flex: none; width: 22px; height: 22px; color: var(--accent-ink); border-radius: 5px; overflow: hidden; }
  .proj__icon svg { width: 100%; height: 100%; display: block; }
  .proj__name { margin: 0; margin-right: auto; font-size: var(--step-1); line-height: 1.2; }
  .proj__name a { color: inherit; text-decoration: none; }
  .proj__name a::after { content: ''; position: absolute; inset: 0; }
  .proj:hover .proj__name a { color: var(--accent-ink); }
  .proj__arrow { width: 16px; height: 16px; flex: none; color: var(--muted); transition: color 0.2s var(--ease), transform 0.25s var(--ease); }
  .proj:hover .proj__arrow { color: var(--accent); transform: translate(2px, -2px); }

  .proj__stack { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0; position: relative; z-index: 1; }
  .proj__stack span {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    color: var(--muted);
    transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .proj__stack span:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px currentColor inset; }
  .proj__tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin: 0; position: relative; z-index: 1; }
  .proj__badge {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .proj__badge:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px currentColor inset; }
  .proj__badge--year {
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted);
    background: var(--bg-sunken);
    border-color: var(--line);
  }
  .proj__badge--poc {
    color: var(--muted);
    background: var(--bg-sunken);
    border-color: var(--line-strong);
  }
  .proj__badge--experimental {
    color: var(--muted);
    background: transparent;
    border-color: var(--line-strong);
    border-style: dashed;
  }
  .proj__badge--product {
    color: var(--accent-ink);
    background: var(--accent-wash);
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
  }
  .proj__badge--library {
    color: var(--lib-ink);
    background: var(--lib-wash);
    border-color: color-mix(in oklab, var(--lib-accent) 40%, transparent);
  }
  .proj__badge--opensource {
    color: var(--os-ink);
    background: var(--os-wash);
    border-color: color-mix(in oklab, var(--os-accent) 40%, transparent);
  }
  .proj__blurb { margin: 0; flex: 1; color: var(--ink-soft); font-size: var(--step--1); line-height: 1.55; }
  .proj__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: var(--space-2) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    position: relative;
    z-index: 1;
  }
  .proj__more { margin-left: auto; font-family: var(--font-mono); font-size: 0.72rem; }
</style>
