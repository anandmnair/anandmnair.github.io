---
import { getSections } from '../nav';

const sections = await getSections();
const path = Astro.url.pathname;
const isCurrent = (item: { href: string; section: string }) =>
  item.section === '' ? path === '/' : path === item.href || path.startsWith(item.href);

/* Feather-style line icons (24x24, stroke=currentColor), keyed by section folder name. */
const ICONS: Record<string, string> = {
  '': '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  about: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  agile:
    '<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
  ai: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/>',
  craftsmanship:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  development: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  'devops-sre':
    '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/>',
  'digital-transformation':
    '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  notes:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8M16 17H8"/>',
  projects: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
  teams:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  technology:
    '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
};
const DEFAULT_ICON = '<circle cx="12" cy="12" r="9"/>';
---

<nav class="tabs" aria-label="Sections">
  <ul>
    {sections.map((s) => (
      <li>
        <a href={s.href} aria-current={isCurrent(s) ? 'page' : undefined} title={s.description}>
          <svg class="tabs__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[s.section] ?? DEFAULT_ICON} />
          <span class="tabs__label">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Fade the edge so a cut-off tab reads as "scroll me". */
    mask-image: linear-gradient(90deg, transparent 0, #000 1.1rem, #000 calc(100% - 1.6rem), transparent 100%);
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs ul {
    display: flex;
    justify-content: space-between;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    min-width: 100%;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    position: relative;
    padding: 0.72rem 0.8rem 0.85rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1.2;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s var(--ease);
  }
  .tabs__icon {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
    transition: opacity 0.18s var(--ease);
  }
  .tabs a:hover .tabs__icon,
  .tabs a[aria-current='page'] .tabs__icon { opacity: 1; }
  .tabs a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s var(--ease);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a:hover::after { transform: scaleX(0.55); }
  .tabs a[aria-current='page'] { color: var(--accent-ink); font-weight: 700; }
  .tabs a[aria-current='page']::after { transform: scaleX(1); }
</style>

<script is:inline>
  /* Keep the active tab in view when the bar is scrolled horizontally. */
  document.querySelector('.tabs a[aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
</script>
