---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string[];
  tags?: string[];
  headings?: MarkdownHeading[];
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description, eyebrow, meta = [], tags = [], headings = [], type, publishedAt } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description} type={type} publishedAt={publishedAt}>
  <div class="shell doc">
    <article class="doc__body">
      <header class="doc__head reveal">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {(meta.length > 0 || tags.length > 0) && (
          <div class="doc__meta">
            {meta.map((m) => <span class="doc__metaitem">{m}</span>)}
            {tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}
      </header>

      <div class="prose reveal">
        <slot />
      </div>
    </article>

    {toc.length > 1 && (
      <aside class="doc__toc" aria-label="On this page">
        <p class="doc__toctitle">On this page</p>
        <nav>
          <ul>
            {toc.map((h) => (
              <li class:list={[`lvl-${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5) 0 0;
  }
  .doc__body { min-width: 0; }
  .doc__head { padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); margin-bottom: var(--space-4); }
  .doc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: var(--space-3); }
  .doc__metaitem { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.04em; }
  .doc__metaitem + .doc__metaitem::before { content: '·'; margin-right: 0.55rem; }

  .doc__toc { position: sticky; top: 5.5rem; font-size: var(--step--1); }
  .doc__toctitle {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }
  .doc__toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .doc__toc li a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.85rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
  }
  .doc__toc li.lvl-3 a { padding-left: 1.7rem; font-size: 0.92em; }
  .doc__toc li a:hover { color: var(--ink); }
  .doc__toc li a.is-current { color: var(--accent-ink); border-left-color: var(--accent); }

  @media (max-width: 1000px) {
    .doc { grid-template-columns: minmax(0, 1fr); }
    .doc__toc { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const links = [...document.querySelectorAll('.doc__toc a')];
    if (!links.length) return;
    const byId = new Map(links.map((a) => [decodeURIComponent(a.getAttribute('href').slice(1)), a]));
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean);

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.classList.remove('is-current'));
          byId.get(e.target.id)?.classList.add('is-current');
        });
      },
      { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => obs.observe(t));
  })();
</script>
