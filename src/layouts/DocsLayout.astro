---
import BaseLayout from './BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { getReadingOrder, getSections } from '../nav';
import { site } from '../site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  section: string;
  updated?: Date;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { title, description, section, updated, tags = [], headings = [] } = Astro.props;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const sections = await getSections();
const parent = sections.find((s) => s.section === section);

const order = await getReadingOrder();
const here = order.findIndex((n) => n.href === Astro.url.pathname);
const prev = here > 0 ? order[here - 1] : undefined;
const next = here > -1 && here < order.length - 1 ? order[here + 1] : undefined;
---

<BaseLayout title={title} description={description}>
  <div class:list={['layout', { 'layout--notoc': toc.length < 2 }]}>
    <aside class="layout__side"><SectionNav section={section} /></aside>

    <main id="main" class="layout__main" data-pagefind-body>
      <article>
        <header class="doc__head">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {parent && <><span aria-hidden="true">/</span><a href={parent.href}>{parent.label}</a></>}
          </nav>

          <h1>{title}</h1>
          <p class="lede">{description}</p>

          {site.wip.enabled && (
            <p class="wipnote"><span>{site.wip.label}</span> {site.wip.note}</p>
          )}

          {(updated || tags.length > 0) && (
            <div class="doc__meta">
              {updated && (
                <time datetime={updated.toISOString().slice(0, 10)}>
                  Updated {updated.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                </time>
              )}
              {tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
        </header>

        <div class="prose"><slot /></div>
      </article>

      {(prev || next) && (
        <nav class="pager" aria-label="Previous and next page">
          {prev ? (
            <a class="pager__link" href={prev.href}>
              <span class="pager__dir">← Previous</span>
              <span class="pager__title">{prev.label}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="pager__link pager__link--next" href={next.href}>
              <span class="pager__dir">Next →</span>
              <span class="pager__title">{next.label}</span>
            </a>
          )}
        </nav>
      )}
    </main>

    {toc.length > 1 && (
      <aside class="layout__toc" aria-label="On this page">
        <p class="toc__title">On this page</p>
        <nav>
          <ul>
            {toc.map((h) => (
              <li class:list={[`lvl-${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-ink); }

  .doc__head { padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); margin-bottom: var(--space-4); }
  .doc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: var(--space-3); }
  .doc__meta time { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); letter-spacing: 0.04em; }

  .wipnote {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: var(--space-3) 0 0;
    padding: 0.55rem 0.8rem;
    border: 1px dashed color-mix(in oklab, var(--accent) 42%, transparent);
    border-radius: var(--radius-lg);
    background: var(--accent-wash);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .wipnote span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
    flex: none;
  }

  .layout__toc { position: sticky; top: 8.5rem; max-height: calc(100vh - 10rem); overflow-y: auto; font-size: var(--step--1); }
  .toc__title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }
  .layout__toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .layout__toc li a {
    display: block;
    padding: 0.26rem 0 0.26rem 0.85rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
  }
  .layout__toc li.lvl-3 a { padding-left: 1.7rem; font-size: 0.93em; }
  .layout__toc li a:hover { color: var(--ink); }
  .layout__toc li a.is-current { color: var(--accent-ink); border-left-color: var(--accent); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pager__link {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .pager__link:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pager__link--next { text-align: right; }
  .pager__dir { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; color: var(--accent-ink); }
  .pager__title { font-family: var(--font-display); font-size: var(--step-1); }

  @media (max-width: 1180px) {
    .layout__toc { display: none; }
  }
  @media (max-width: 900px) {
    .pager { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (() => {
    const links = [...document.querySelectorAll('.layout__toc a')];
    if (!links.length) return;
    const byId = new Map(links.map((a) => [decodeURIComponent(a.getAttribute('href').slice(1)), a]));
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean);
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.classList.remove('is-current'));
          byId.get(e.target.id)?.classList.add('is-current');
        });
      },
      { rootMargin: '-140px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => obs.observe(t));
  })();
</script>
